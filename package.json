{
  "name": "regatta-flight-planner",
  "version": "0.0.1",
  "description": "Fair flight plans for league-style fleet regattas, as an offline PWA",
  "main": "index.js",
  "scripts": {
    "dev-server": "vite --open",
    "dev": "npm run dev-server",
    "dev-task": "vite",
    "build": "tsc && vite build",
    "start": "npm run dev",
    "start-remote": "vite --host",
    "solve": "tsx scripts/solve.ts",
    "test": "tsx --test src/solver/*.test.ts",
    "test:determinism": "playwright test"
  },
  "author": "@prejs",
  "license": "MIT",
  "dependencies": {
    "@thepassle/app-tools": "^0.9.12",
    "lit": "^3.2.1",
    "urlpattern-polyfill": "^10.0.0",
    "workbox-build": "^7.1.1",
    "workbox-core": "^7.1.0",
    "workbox-precaching": "^7.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vite-plugin-pwa": "^0.20.5"
  },
  "prettier": {
    "tabWidth": 2,
    "useTabs": false,
    "semi": true,
    "singleQuote": true,
    "quoteProps": "consistent",
    "trailingComma": "es5",
    "endOfLine": "crlf",
    "bracketSpacing": true
  },
  "private": true
}
